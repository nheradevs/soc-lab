# SOC lab monitoring - environment template
#
# The REAL .env lives ONLY on asgard at ~/monitoring/.env
# (chmod 600). Never commit it, never copy it into the repo or anywhere else.
# Copy this file to .env on asgard and fill in the real values.

# --- Wazuh manager API (kept for general API access; not used by the forwarder) ---
WAZUH_API_URL=https://localhost:55000
WAZUH_USER=<wazuh api username>
WAZUH_PASS=<wazuh api password>

# --- Wazuh indexer / OpenSearch (used by the forwarder to read alerts) ---
# Wazuh >= 4.8 removed GET /alerts from the manager API, so the forwarder
# queries the indexer directly.
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=<opensearch admin password>

# --- Telegram ---
# Leave empty (and DRY_RUN=true) until you have a bot token + chat id.
TG_BOT_TOKEN=
TG_CHAT_ID=
# "true" = log "WOULD SEND" lines instead of calling Telegram (test mode)
DRY_RUN=true

# --- Forwarder tuning ---
# Comma-separated Wazuh rule ids to forward
RULES=100501,100504,501,502
# Minimum seconds between two sends for the same (source, rule) pair
COOLDOWN_SECONDS=60
# Seconds between indexer polls
POLL_INTERVAL=10

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=<set a strong password>
